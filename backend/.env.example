# База данных
# DATABASE_URL=sqlite:///./habit_tracker.db
# DATABASE_URL=postgresql+psycopg://USER:PASS@localhost:5432/habit_tracker

# Отправка кодов по email (Mail.ru / bk.ru / inbox.ru)
# Пароль — «пароль для внешнего приложения» в настройках почты, не пароль от входа.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=your@mail.ru
SMTP_PASSWORD=app-password-here
SMTP_FROM=your@mail.ru
SMTP_TLS=true

# Код дублируется в консоль backend (удобно при отладке)
# OTP_DEV_LOG_CODE=true
